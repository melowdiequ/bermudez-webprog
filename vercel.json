{
  "version": 2,
  "buildCommand": "npm run build --prefix BERMUDEZ_LabActivity/bermudez-client",
  "outputDirectory": "BERMUDEZ_LabActivity/bermudez-client/dist",
  "installCommand": "npm install --prefix BERMUDEZ_LabActivity/bermudez-client && npm install --prefix BERMUDEZ_LabActivity/bermudez-server",
  "env": [
    "VITE_API_URL",
    "MONGO_URI",
    "JWT_SECRET",
    "CORS_ORIGIN",
    "NODE_ENV"
  ],
  "functions": {
    "api/**/*.js": {
      "runtime": "nodejs20.x",
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api",
      "methods": ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"]
    },
    {
      "src": "/(.*)",
      "dest": "/index.html",
      "status": 200
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    }
  ]
}
